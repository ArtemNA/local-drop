# Server Configuration
PORT=3000

# Deployment Mode
# Set to 'true' for public deployment with room-based isolation
# Leave empty or 'false' for local network mode
PUBLIC_DEPLOY=false

# Auto-Room Mode (works with PUBLIC_DEPLOY=true)
# Set to 'true' to automatically group devices from same local network
# Uses WebRTC to detect client's local IP for room assignment
# Users can still create/join manual rooms
AUTO_ROOM=false

# Optional: Custom STUN/TURN servers for better connectivity
# STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password
