# Server Configuration
PORT=3000

# Deployment Mode
# Set to 'true' for public deployment with room-based isolation
# Leave empty or 'false' for local network mode
PUBLIC_DEPLOY=false

# Auto-Room Mode (only works with PUBLIC_DEPLOY=true)
# Set to 'true' to automatically create rooms based on IP addresses
# Users from the same network will auto-join the same room
# Leave empty or 'false' for manual room creation
AUTO_ROOM=false

# Optional: Custom STUN/TURN servers for better connectivity
# STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password
